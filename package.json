{
  "name": "remotion-product-motion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Create fluid, readable product showcase videos in Remotion.",
  "license": "MIT",
  "engines": {"node": ">=24"},
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck",
    "studio": "remotion studio examples/index.tsx",
    "render": "remotion render examples/index.tsx ProductLandscape out/product.mp4 --concurrency=1",
    "test:render": "node scripts/render-check.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/motion-blur": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2"
  }
}
